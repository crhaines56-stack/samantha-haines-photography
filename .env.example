# Anthropic API (chatbot)
ANTHROPIC_API_KEY=

# Unsplash API (placeholder images)
UNSPLASH_ACCESS_KEY=

# Resend (email delivery)
RESEND_API_KEY=

# Inquiry form recipient. Used by app/api/contact/route.ts.
# Set CONTACT_EMAIL in Vercel to the address below.
# If it is unset, the route uses that same address.
# crhaines56@gmail.com is ignored if it is still the configured value.
CONTACT_EMAIL=samantha@samanthahainesphotography.com

# Public site origin. Apex host, no www. Used for gallery links.
# Set this in Vercel to https://samanthahainesphotography.com
NEXT_PUBLIC_SITE_URL=https://samanthahainesphotography.com

# Cloudinary (image storage + galleries)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Search Console
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# Google Analytics (GA4). Measurement ID must start with G- (for example G-XXXXXXXX).
# Set NEXT_PUBLIC_GA_MEASUREMENT_ID in Vercel. Leave it blank to omit analytics.
# An empty or non-G- value is not rendered, so gtag cannot ship with id=undefined.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cal.com (booking widget)
NEXT_PUBLIC_CALCOM_LINK=

# Gallery system
GALLERY_ADMIN_SECRET=
